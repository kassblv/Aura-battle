{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm view *)",
      "Bash(node *)",
      "Bash(npx tsx *)",

      "Bash(docker compose ps*)",
      "Bash(docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose start*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose config*)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker info*)",
      "Bash(docker logs *)",

      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git branch*)",
      "Bash(git mv *)",
      "Bash(git rm --cached *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git remote *)",
      "Bash(git ls-files*)",

      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh auth status*)",
      "Bash(gh api repos/*)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd*)",
      "Bash(basename *)",
      "Bash(dirname *)",

      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(tee *)",
      "Bash(chmod *)",
      "Bash(python3 *)",
      "Bash(python3 -*)",

      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s -m * http://localhost:*)",
      "Bash(curl * http://localhost:*)",
      "Bash(curl * http://127.0.0.1:*)",
      "Bash(pkill -f *)",
      "Bash(ipconfig getifaddr *)",

      "Read",
      "Edit(./apps/**)",
      "Edit(./packages/**)",
      "Edit(./docs/**)",
      "Edit(./.github/**)",
      "Write(./apps/**)",
      "Write(./packages/**)",
      "Write(./docs/**)",
      "Write(./.github/**)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm *)",
      "Bash(pnpm --filter server prisma migrate reset *)",
      "Bash(pnpm exec prisma migrate reset*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Edit(./prototype/**)",
      "Write(./prototype/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ]
  }
}
