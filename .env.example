# Copie ce fichier en .env et adapte les valeurs.

# --- Base de donnees (docker compose) ---
# Port 5433 : voir docker-compose.yml (collision avec un PostgreSQL natif qui
# ecoute deja sur 5432).
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_DB=aura
DATABASE_URL=postgresql://aura:aura@localhost:5433/aura?schema=public

# --- Redis (docker compose) ---
REDIS_URL=redis://localhost:6379

# --- Serveur ---
NODE_ENV=development
PORT=3000
# Secret de signature des JWT. En production : valeur longue et aleatoire.
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Client ---
# URL du serveur vue par le client. Sur telephone, remplacer localhost par l'IP LAN du Mac.
VITE_SERVER_URL=http://localhost:3000
